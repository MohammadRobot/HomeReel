# Copy this file to .env and edit values before starting the stack.

# Absolute installation directory. Blank uses the current directory (PWD).
# Run Compose from the project root, or set this explicitly when using -f elsewhere.
MEDIA_SERVER_PROJECT_DIR=

# Bind published web ports to the server's LAN IP.
# Keep this as 127.0.0.1 for local-only testing.
LAN_BIND_IP=127.0.0.1

# Match the user/group that owns ./config and /media.
PUID=1000
PGID=1000
UMASK=002
TZ=Asia/Dubai

# Persistent container configuration root.
CONFIG_ROOT=./config

# Media storage root on the Data hard drive.
MEDIA_ROOT=/mnt/data/media

# Published web ports.
LANDING_PORT=8090
JELLYFIN_PORT=8096
QBT_WEBUI_PORT=8080
QBT_TORRENT_PORT=6881
SONARR_PORT=8989
RADARR_PORT=7878
JACKETT_PORT=9117

# Web update control. Leave blank to allow the landing page to run updates
# without a token. Set a long private value to require a token prompt.
UPDATE_TOKEN=

# Set this to the URL Samsung TV clients should use after LAN_BIND_IP is set.
JELLYFIN_PUBLISHED_URL=http://127.0.0.1:8096

# Jellyfin NVIDIA GPU transcoding. Requires NVIDIA Container Toolkit on the host.
JELLYFIN_NVIDIA_VISIBLE_DEVICES=all
JELLYFIN_NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
JELLYFIN_NVIDIA_GPU_COUNT=all

# Read the qBittorrent legal notice, then set this to confirm.
# https://github.com/qbittorrent/docker-qbittorrent-nox/blob/main/legal_notice.md
QBT_LEGAL_NOTICE=

# Explicit image tags. Avoid "latest".
LANDING_IMAGE=nginxinc/nginx-unprivileged:1.30.5-alpine
UPDATER_BASE_IMAGE=docker:29.8.1-cli
UPDATER_IMAGE=media-server-updater:1
JELLYFIN_IMAGE=jellyfin/jellyfin:12.1
QBITTORRENT_IMAGE=qbittorrentofficial/qbittorrent-nox:5.2.3-1
SONARR_IMAGE=lscr.io/linuxserver/sonarr:4.0.20.3014-ls325
RADARR_IMAGE=lscr.io/linuxserver/radarr:6.4.4.10685-ls317
JACKETT_IMAGE=lscr.io/linuxserver/jackett:v0.24.2624-ls33
WATCHTOWER_IMAGE=nickfedor/watchtower:1.22.2

# Watchtower checks labeled containers daily at 04:00 container local time.
WATCHTOWER_CLEANUP=true
WATCHTOWER_SCHEDULE="0 0 4 * * *"
